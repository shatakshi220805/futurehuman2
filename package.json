{
  "name": "futurehuman",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@futurehuman/web",
    "dev:web": "turbo run dev --filter=@futurehuman/web",
    "dev:desktop": "turbo run dev --filter=@futurehuman/desktop",
    "dev:mobile": "turbo run start --filter=@futurehuman/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @futurehuman/db generate",
    "db:migrate": "pnpm --filter @futurehuman/db migrate",
    "db:push": "pnpm --filter @futurehuman/db push",
    "db:seed": "pnpm --filter @futurehuman/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
