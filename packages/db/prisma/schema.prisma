generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  BASIC
  PLUS
  POWER
  PRO
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum MemorySource {
  SCREEN
  MEETING
  EMAIL
  CALENDAR
  SLACK
  NOTION
  DRIVE
  OUTLOOK
  CHAT
  MANUAL
}

enum MeetingStatus {
  CAPTURING
  PROCESSING
  READY
  FAILED
}

enum RoutineStatus {
  ACTIVE
  PAUSED
}

enum RoutineDelivery {
  IN_APP
  EMAIL
  IMESSAGE
}

enum IntegrationProvider {
  GMAIL
  GOOGLE_CALENDAR
  SLACK
  NOTION
  GOOGLE_DRIVE
  OUTLOOK
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  REVOKED
}

model User {
  id               String   @id
  email            String   @unique
  name             String?
  imageUrl         String?
  osPreference     String?
  capturePaused    Boolean  @default(false)
  onboardingComplete Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships      Membership[]
  ownedOrgs        Organization[] @relation("OrgOwner")
  memoryItems      MemoryItem[]
  chats            Chat[]
  meetings         Meeting[]
  routines         Routine[]
  integrations     Integration[]
  mcpTokens        McpToken[]
  auditLogs        AuditLog[]
  usagePeriods     UsagePeriod[]
  blocklist        CaptureBlocklist[]
  emailCaptures    EmailCapture[]
  messages         MessagingIdentity[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  clerkOrgId  String?  @unique
  ownerId     String
  ssoEnabled  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("OrgOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  subscription Subscription?
  memoryItems MemoryItem[]
  auditLogs   AuditLog[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String?             @unique
  organizationId       String?             @unique
  stripeCustomerId     String              @unique
  stripeSubscriptionId String?             @unique
  plan                 Plan                @default(BASIC)
  interval             BillingInterval     @default(MONTHLY)
  status               SubscriptionStatus  @default(NONE)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

model UsagePeriod {
  id                String   @id @default(cuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  creditsUsed       Int      @default(0)
  creditsLimit      Int      @default(0)
  meetingNotesCount Int      @default(0)
  maxModeCount      Int      @default(0)
  extraCredits      Int      @default(0)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId])
}

model MemoryItem {
  id             String       @id @default(cuid())
  userId         String
  organizationId String?
  source         MemorySource
  app            String?
  project        String?
  text           String
  timestamp      DateTime     @default(now())
  sessionId      String?
  meetingId      String?
  /// 1536-d embedding stored via pgvector; queried with raw SQL.
  embedding      Unsupported("vector(1536)")?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  chunks         MemoryChunk[]
  meeting        Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([userId, app])
  @@index([userId, project])
  @@index([sessionId])
}

model MemoryChunk {
  id           String      @id @default(cuid())
  memoryItemId String
  ordinal      Int
  text         String
  embedding    Unsupported("vector(1536)")?

  memoryItem   MemoryItem  @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@index([memoryItemId])
}

model Chat {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  sources   Json?
  createdAt DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Meeting {
  id             String        @id @default(cuid())
  userId         String
  title          String
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  status         MeetingStatus @default(CAPTURING)
  language       String        @default("en")
  consentShown   Boolean       @default(false)
  jurisdiction   String?
  attendees      Json?
  summary        String?
  transcript     String?
  gmailDraftId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItems    ActionItem[]
  memoryItems    MemoryItem[]
  speakers       MeetingSpeaker[]

  @@index([userId, startedAt])
}

model MeetingSpeaker {
  id        String  @id @default(cuid())
  meetingId String
  label     String
  name      String?

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id        String   @id @default(cuid())
  meetingId String
  text      String
  owner     String?
  dueAt     DateTime?
  done      Boolean  @default(false)

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Routine {
  id          String          @id @default(cuid())
  userId      String
  name        String
  prompt      String
  schedule    String
  timezone    String          @default("UTC")
  sources     Json
  delivery    RoutineDelivery @default(IN_APP)
  status      RoutineStatus   @default(ACTIVE)
  isDefault   Boolean         @default(false)
  nextRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        RoutineRun[]

  @@index([userId, status])
  @@index([nextRunAt])
}

model RoutineRun {
  id          String   @id @default(cuid())
  routineId   String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String
  output      String?
  error       String?
  attempt     Int      @default(1)

  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, startedAt])
}

model Integration {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(CONNECTED)
  accountEmail String?
  scopes       String[]
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt    DateTime?
  cursor       String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model McpToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  hashedToken String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CaptureBlocklist {
  id        String   @id @default(cuid())
  userId    String
  pattern   String
  kind      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MessagingIdentity {
  id         String   @id @default(cuid())
  userId     String
  channel    String
  address    String
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, address])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  target         String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model EmailCapture {
  id          String   @id @default(cuid())
  email       String
  os          String?
  source      String   @default("download")
  userId      String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  publishedAt DateTime?
  author      String   @default("Futurehuman")
  createdAt   DateTime @default(now())
}
