# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Futurehuman
NODE_ENV=development

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://futurehuman:futurehuman@localhost:5432/futurehuman?schema=public
DIRECT_URL=postgresql://futurehuman:futurehuman@localhost:5432/futurehuman?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/onboarding

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_PLUS_MONTHLY=price_plus_monthly
STRIPE_PRICE_PLUS_ANNUAL=price_plus_annual
STRIPE_PRICE_POWER_MONTHLY=price_power_monthly
STRIPE_PRICE_POWER_ANNUAL=price_power_annual
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual

# Anthropic
ANTHROPIC_API_KEY=sk-ant-replace_me

# Embeddings (OpenAI-compatible HTTP; no extra SDK)
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Speech-to-text
DEEPGRAM_API_KEY=

# Email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Futurehuman <hello@futurehuman.ai>

# Object storage (encrypted blobs)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# Token encryption at rest
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Inngest
